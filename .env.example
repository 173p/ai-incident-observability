# Copy to .env on the monitoring server and fill in real values. Never commit .env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=-1000000000000
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_MODEL=google/gemma-4-31b-it:free
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
APP_BASE_URL=http://<monitoring-server-ip>:5000
